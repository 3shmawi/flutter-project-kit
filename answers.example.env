# Non-interactive run:  ./new_project.sh --answers answers.example.env
APP_NAME="Cafe Menu"
PROJECT_NAME=cafe_menu
PACKAGE_ID=com.yourname.cafemenu
DESCRIPTION="Understand any cafe menu: photos, plain-language descriptions, calories and prices."
ENVIRONMENTS=full          # full | staging-prod | prod
ARCHITECTURE=simple        # simple | layered
STATE=riverpod             # bloc | riverpod | none
MONITORING=sentry          # sentry | clarity | none
CI=github                  # github | codemagic
VISIBILITY=public          # public | private
PRIMARY_COLOR="#7C4A2D"
DEEPLINK_DOMAIN=""         # e.g. cafemenu.app — empty to skip https links
CREATE_REPO=yes            # yes | no
OUTPUT_DIR="~/Projects"
