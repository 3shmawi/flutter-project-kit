rules_version = '2';

// Cloud Firestore security rules — the ONLY thing standing between the
// public app config (env/*.json) and your data. Deny by default; open each
// collection explicitly and prove it in firebase/tests/ (see docs/backend.md).
// Deployed on merge to main by .github/workflows/firebase.yml.
service cloud.firestore {
  match /databases/{database}/documents {

    // Version-update gate: one document per platform (android, ios).
    // Anyone can read; only CI (service account, bypasses rules) writes.
    match /app_versions/{platform} {
      allow read: if platform in ['android', 'ios'];
      allow write: if false;
    }

    // @@if auth
    // Each user's own document (deleted with the account by the app,
    // core/auth/backend_auth.dart). Template for any user-owned data:
    // only the owner, only known fields, bounded sizes.
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['display_name', 'updated_at'])
        && (!('display_name' in request.resource.data)
            || (request.resource.data.display_name is string
                && request.resource.data.display_name.size() <= 80));
    }
    // @@else
    // Example for user-owned data (uncomment when Firebase Auth is added):
    // match /users/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
    // @@endif

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
