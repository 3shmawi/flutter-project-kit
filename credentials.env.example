# Store credentials — copy to ~/.flutter-kit/credentials.env and keep it private
# (chmod 600). Point the paths at the files you already use for your other apps.
# Read by scripts/setup_secrets.sh to fill each new repo's GitHub secrets.

# ---- Android (one upload keystore can sign all your apps) ----
ANDROID_KEYSTORE_PATH="~/keys/upload-keystore.jks"
ANDROID_KEYSTORE_PASSWORD=""
ANDROID_KEY_ALIAS="upload"
ANDROID_KEY_PASSWORD=""
PLAY_SERVICE_ACCOUNT_JSON_PATH="~/keys/google-play-service-account.json"

# ---- iOS: App Store Connect API key (Users and Access → Integrations → Keys) ----
APP_STORE_CONNECT_ISSUER_ID=""
APP_STORE_CONNECT_KEY_IDENTIFIER=""
APP_STORE_CONNECT_PRIVATE_KEY_PATH="~/keys/AuthKey_XXXXXXXXXX.p8"

# RSA key for the iOS distribution certificate, shared by all apps.
# Create once:  ssh-keygen -t rsa -b 2048 -m PEM -f ~/keys/ios_distribution_private_key -q -N ""
CERTIFICATE_PRIVATE_KEY_PATH="~/keys/ios_distribution_private_key"
